{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "folio",
  "version": "1.0.0",
  "identifier": "app.folio.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Folio : Local PDF Studio",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "publisher": "folio",
    "copyright": "Copyright (C) 2026 folio contributors. Licensed under GPL-3.0-or-later.",
    "category": "Productivity",
    "shortDescription": "Free, fully offline PDF tools.",
    "longDescription": "folio does everything you need with a PDF — merge, split, compress, protect, watermark, redact and OCR — entirely on your own computer. No cloud, no account, no upload, free forever.",
    "licenseFile": "../LICENSE",
    "resources": {
      "runtime/*.exe": "./",
      "runtime/*.dll": "./",
      "runtime/tessdata/*.traineddata": "./tessdata/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
